.idea/

# Large, reproducible resources; keep their provenance in Git.
/assets/*
!/assets/manifest.json
/outputs/
/dist/
/build/
*.egg-info/

# Local secrets and operating-system files.
.env
.env.*
!.env.example
*.log
Thumbs.db
.DS_Store
