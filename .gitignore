# Local environments and package caches.
.venv/
venv/
.conda-env/
.conda-pkgs/
.upstream-clone-incomplete/

# Python and editor caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
